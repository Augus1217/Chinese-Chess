{
  "name": "chinese-chess-by-augus",
  "version": "1.4.3",
  "description": "A web-based interface for Chinese Chess engines.",
  "author": "Augus <imlindora@gmail.com>",
  "homepage": "https://github.com/Augus1217/Chinese-Chess",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.12.0"
  },
  "devDependencies": {
    "electron": "28.0.0",
    "electron-builder": "^24.9.1"
  },
    "build": {
    "appId": "com.augus.chinese.chess",
    "productName": "中華象棋",
    "asarUnpack": [
      "api/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "public/",
      "api/",
      "build/",
      "api/cpu_features.exe",
      "api/libgcc_s_seh-1.dll",
      "api/libstdc++-6.dll",
      "api/libwinpthread-1.dll",
      "api/websocket.js",
      "api/nlohmann/"
    ],
    "extraResources": [
      {
        "from": "engine 20250627/",
        "to": "engine"
      }
    ],
    "win": {
      "target": [
        "nsis",
	"portable"
      ],
      "icon": "build/icons"
    },
    "appx": {
      "identityName": "YOUR_IDENTITY_NAME_FROM_PARTNER_CENTER",
      "publisher": "CN=YOUR_PUBLISHER_ID_FROM_PARTNER_CENTER",
      "publisherDisplayName": "Your Publisher Display Name",
      "applicationId": "ChineseChess",
      "displayName": "中華象棋"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap"
      ],
      "icon": "build/icons",
      "category": "Game"
    },
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "base": "core22",
      "stagePackages": [
        "libatomic1",
        "libstdc++6",
        "libnss3"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true
    }
  }
}